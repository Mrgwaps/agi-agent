# ============================================================
#  AGI Agent - Environment Configuration
#  Copy this file to .env and fill in your values
# ============================================================

# ----------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-long-random-string

# ----------------------------------------------------------
# OPENROUTER (Required for cloud models)
# Get your key at https://openrouter.ai/keys
# ----------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=AGI-Agent-Demo

# Model routing preferences
PREFER_FREE_MODELS=true
MAX_BUDGET_USD=5.00
DEFAULT_PLANNING_MODEL=meta-llama/llama-3.3-70b-instruct:free
DEFAULT_CODING_MODEL=deepseek/deepseek-r1:free
DEFAULT_WEB_MODEL=google/gemma-3-27b-it:free
DEFAULT_GENERAL_MODEL=mistralai/mistral-7b-instruct:free

# ----------------------------------------------------------
# OLLAMA (Optional - local model support)
# ----------------------------------------------------------
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# ----------------------------------------------------------
# HYPERBROWSER (Optional - advanced web tasks)
# Get your key at https://app.hyperbrowser.ai
# ----------------------------------------------------------
HYPERBROWSER_API_KEY=your-hyperbrowser-key-here
HYPERBROWSER_BASE_URL=https://api.hyperbrowser.ai

# ----------------------------------------------------------
# WAVESPEED AI (Optional - image & video generation)
# Get your key at https://wavespeed.ai
# ----------------------------------------------------------
WAVESPEED_API_KEY=your-wavespeed-key-here

# ----------------------------------------------------------
# GOOGLE MAPS (Optional - geocoding, places, directions)
# Get your key at https://console.cloud.google.com/apis
# ----------------------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# ----------------------------------------------------------
# HUGGING FACE (Optional - open-source model inference)
# Get your key at https://huggingface.co/settings/tokens
# ----------------------------------------------------------
HUGGINGFACE_API_KEY=hf_your-key-here

# ----------------------------------------------------------
# SERPAPI (Optional - Google search results)
# Falls back to DuckDuckGo automatically if not set
# Get your key at https://serpapi.com
# ----------------------------------------------------------
SERP_API_KEY=your-serpapi-key-here

# ----------------------------------------------------------
# FAL.AI (Optional - Kokoro TTS, image generation)
# Get your key at https://fal.ai/dashboard/keys
# Format: {user_id}:{key_id}
# ----------------------------------------------------------
FAL_API_KEY=your-fal-api-key-here

# ----------------------------------------------------------
# HEYGEN (Optional - Interactive AI Avatar streaming)
# Get your key at https://app.heygen.com/settings
# ----------------------------------------------------------
HEYGEN_API_KEY=your-heygen-api-key-here

# ----------------------------------------------------------
# DATABASE
# ----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agi_agent
POSTGRES_USER=agi_user
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://agi_user:change-me-strong-password@postgres:5432/agi_agent

# ----------------------------------------------------------
# REDIS
# ----------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# ----------------------------------------------------------
# CHROMADB (Vector Store)
# ----------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=/data/chroma

# ----------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AGI Agent

# ----------------------------------------------------------
# SECURITY
# ----------------------------------------------------------
REQUIRE_APPROVAL_CODE_EXECUTION=true
REQUIRE_APPROVAL_FILE_WRITES=false
REQUIRE_APPROVAL_WEB_REQUESTS=false
MAX_RETRIES_PER_STEP=3
TOOL_EXECUTION_TIMEOUT_SECONDS=30

# ----------------------------------------------------------
# OBSERVABILITY
# ----------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_TELEMETRY=true
OTLP_ENDPOINT=http://jaeger:4317
