# ============================================================
#  AGI Agent - Local Mode (no Docker required)
#  Copy this to .env in the backend/ folder:
#    cp .env.local.example backend/.env
# ============================================================

# ----------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ----------------------------------------------------------
# OPENROUTER (Required for cloud models)
# Get your key at https://openrouter.ai/keys
# Free models are used by default - zero cost to start!
# ----------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=AGI-Agent-Local

# Always prefer free models (recommended for local dev)
PREFER_FREE_MODELS=true
MAX_BUDGET_USD=2.00

# ----------------------------------------------------------
# OLLAMA (Optional - 100% local models, no API key needed)
# Install from https://ollama.ai then run: ollama pull llama3.2
# ----------------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# ----------------------------------------------------------
# HYPERBROWSER (Optional - advanced web scraping)
# ----------------------------------------------------------
HYPERBROWSER_API_KEY=

# ----------------------------------------------------------
# DATABASE - SQLite for local mode (no server needed!)
# ----------------------------------------------------------
DATABASE_URL=sqlite:///./agi_memory.db

# ----------------------------------------------------------
# REDIS - Disabled for local mode (uses in-memory fallback)
# ----------------------------------------------------------
REDIS_URL=none

# ----------------------------------------------------------
# CHROMADB - Embedded mode (no server needed)
# ----------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./chroma_data

# ----------------------------------------------------------
# WORKSPACE - Where agent files are sandboxed
# ----------------------------------------------------------
WORKSPACE_ROOT=./agi_workspace

# ----------------------------------------------------------
# SECURITY
# ----------------------------------------------------------
REQUIRE_APPROVAL_CODE_EXECUTION=true
REQUIRE_APPROVAL_FILE_WRITES=false
REQUIRE_APPROVAL_WEB_REQUESTS=false
MAX_RETRIES_PER_STEP=3
TOOL_EXECUTION_TIMEOUT_SECONDS=30
